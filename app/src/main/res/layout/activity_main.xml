<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?android:colorBackground">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="PortfolioDocConverter"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Автоматическое оформление\nучебного портфолио"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DOC/DOCX → PDF + сжатие + структура папок"
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="32dp" />

    <!-- Кнопка выбора файлов -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectFiles"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Выбрать файлы"
        android:textSize="16sp"
        app:icon="@android:drawable/ic_menu_upload"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        style="@style/Widget.Material3.Button" />

    <!-- Текст "Выбрано файлов" -->
    <TextView
        android:id="@+id/tvSelectedCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Файлы ещё не выбраны"
        android:textSize="15sp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <!-- Список выбранных файлов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <!-- Кнопка запуска -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Начать обработку"
        android:textSize="16sp"
        android:enabled="false"
        app:icon="@android:drawable/ic_media_play"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        style="@style/Widget.Material3.Button" />

</LinearLayout>